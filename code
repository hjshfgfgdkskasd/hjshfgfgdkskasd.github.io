
<div id="neptune">
  <canvas id="rain"></canvas>
  <canvas id="waves"></canvas>

  <div class="hud">
    <div class="top">
      <span>● NEPTUNE NETWORK</span>
      <span>SECURE CONNECTION // 07</span>
    </div>

    <div class="center">
      <div class="glitch" data-text="TEAM NEPTUNE">
        TEAM NEPTUNE
      </div>
      <div class="subtitle">
        DIGITAL SHADOWS • CYBER OPERATIONS
      </div>
      <div class="line"></div>
      <div id="terminal">
        <p>&gt; Initializing Neptune protocol...</p>
        <p>&gt; Establishing encrypted connection...</p>
        <p>&gt; Scanning virtual network nodes...</p>
        <p class="green">&gt; ACCESS GRANTED_</p>
      </div>
      <div class="status">
        <span>STATUS: ONLINE</span>
        <span id="coords">NODE: 00.00</span>
      </div>
    </div>

    <div class="bottom">
      <span>NEPTUNE // DIGITAL DIVISION</span>
      <span>FOLLOW THE SIGNAL_</span>
    </div>
  </div>
</div>

<style>
#neptune {
  position:relative;
  width:100%;
  height:600px;
  overflow:hidden;
  background:#010604;
  color:#39ff88;
  font-family:Consolas,Monaco,monospace;
  border:1px solid #124a2c;
  box-sizing:border-box;
  isolation:isolate;
}
#neptune canvas {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}
#rain { z-index:0; opacity:.8; }
#waves { z-index:1; pointer-events:none; }
.hud {
  position:absolute;
  inset:0;
  z-index:2;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  padding:20px;
  box-sizing:border-box;
  pointer-events:none;
  background:radial-gradient(
    ellipse at center, transparent 10%, #01060455 100%
  );
}
.top,.bottom,.status {
  display:flex;
  justify-content:space-between;
  gap:12px;
  flex-wrap:wrap;
  font-size:10px;
  letter-spacing:1.5px;
  text-shadow:0 0 8px #39ff88;
}
.center {
  text-align:center;
  width:100%;
  max-width:650px;
  margin:auto;
}
.glitch {
  position:relative;
  color:#a5ffc5;
  font-size:clamp(28px,6vw,60px);
  font-weight:900;
  letter-spacing:3px;
  text-shadow:0 0 8px #39ff88,0 0 25px #00ff6655;
  animation:flicker 3s infinite;
}
.glitch:before,.glitch:after {
  content:attr(data-text);
  position:absolute;
  inset:0;
  overflow:hidden;
}
.glitch:before {
  color:#00ffcc;
  clip-path:inset(20% 0 65% 0);
  animation:shift1 2.5s infinite steps(2);
}
.glitch:after {
  color:#ff315e;
  clip-path:inset(65% 0 15% 0);
  animation:shift2 1.8s infinite steps(2);
}
.subtitle {
  font-size:10px;
  letter-spacing:3px;
  margin-top:16px;
  color:#72ffa7;
}
.line {
  height:1px;
  max-width:360px;
  margin:24px auto;
  background:linear-gradient(90deg,transparent,#39ff88,transparent);
  box-shadow:0 0 10px #39ff88;
}
#terminal {
  text-align:left;
  display:inline-block;
  font-size:12px;
  line-height:1.6;
  color:#54bc7c;
}
#terminal p { margin:3px 0; }
#terminal .green { color:#a5ffc5; }
.status {
  max-width:400px;
  margin:25px auto 0;
  color:#39ff88;
}
@keyframes flicker {
  0%,94%,100% { opacity:1; }
  95% { opacity:.5; }
  97% { opacity:.8; }
}
@keyframes shift1 {
  0%,90%,100% { transform:translateX(0); }
  92% { transform:translateX(-4px); }
  95% { transform:translateX(3px); }
}
@keyframes shift2 {
  0%,88%,100% { transform:translateX(0); }
  90% { transform:translateX(4px); }
  94% { transform:translateX(-3px); }
}
@media(max-width:480px) {
  #neptune { height:500px; }
  .hud { padding:12px; }
  .top,.bottom { font-size:8px; }
  .subtitle { letter-spacing:1px; }
}
</style>

<script>
(function(){
  const root = document.getElementById('neptune');
  const rain = document.getElementById('rain');
  const waves = document.getElementById('waves');
  const rctx = rain.getContext('2d');
  const wctx = waves.getContext('2d');
  const coords = document.getElementById('coords');

  let width, height, drops = [];
  let mouse = {x:-1000,y:-1000};
  let ripples = [];
  const chars = '01アイウエオ<>/{}[]$#NEPTUNE';

  function resize(){
    const rect = root.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = rect.width;
    height = rect.height;

    [rain,waves].forEach(c=>{
      c.width = width*dpr;
      c.height = height*dpr;
      c.style.width = width+'px';
      c.style.height = height+'px';
      c.getContext('2d').setTransform(dpr,0,0,dpr,0,0);
    });

    drops = Array.from(
      {length:Math.ceil(width/14)},
      ()=>Math.random()*-height/14
    );
  }

  root.addEventListener('pointermove',e=>{
    const rect = root.getBoundingClientRect();
    mouse.x = e.clientX-rect.left;
    mouse.y = e.clientY-rect.top;
    coords.textContent =
      'NODE: '+mouse.x.toFixed(0)+'.'+mouse.y.toFixed(0);
  });

  root.addEventListener('pointerleave',()=>{
    mouse.x=-1000;
    mouse.y=-1000;
  });

  root.addEventListener('pointerdown',e=>{
    const rect=root.getBoundingClientRect();
    ripples.push({
      x:e.clientX-rect.left,
      y:e.clientY-rect.top,
      radius:0,
      life:1
    });
  });

  function drawRain(){
    rctx.fillStyle='rgba(1,6,4,0.12)';
    rctx.fillRect(0,0,width,height);
    rctx.font='12px monospace';

    drops.forEach((drop,i)=>{
      const x=i*14;
      const y=drop*14;
      const dx=x-mouse.x;
      const dy=y-mouse.y;
      const distance=Math.sqrt(dx*dx+dy*dy);
      const influence=Math.max(0,1-distance/120);
      const wave=Math.sin((x+Date.now()*.12)/28)*influence;

      rctx.fillStyle=influence>.2?'#c4ffda':'#18a653';
      rctx.globalAlpha=.5+Math.random()*.5;
      rctx.fillText(
        chars[Math.floor(Math.random()*chars.length)],
        x+wave*12,
        y+wave*8
      );
      rctx.globalAlpha=1;

      drop += 0.5+Math.random()*.8;
      if(y>height && Math.random()>.97) drops[i]=0;
    });
  }

  function drawWaves(){
    wctx.clearRect(0,0,width,height);
    const now=Date.now()*.001;

    // Cursor creates expanding circular waves.
    if(mouse.x>-100){
      for(let ring=0;ring<4;ring++){
        const radius=((now*45+ring*34)%150);
        const alpha=(1-radius/150)*.4;
        wctx.beginPath();
        wctx.arc(mouse.x,mouse.y,radius,0,Math.PI*2);
        wctx.strokeStyle='rgba(57,255,136,'+alpha+')';
        wctx.lineWidth=1;
        wctx.stroke();
      }

      // Nearby code bends toward the cursor.
      const glow=wctx.createRadialGradient(
        mouse.x,mouse.y,0,mouse.x,mouse.y,130
      );
      glow.addColorStop(0,'rgba(0,255,100,.12)');
      glow.addColorStop(1,'rgba(0,255,100,0)');
      wctx.fillStyle=glow;
      wctx.fillRect(mouse.x-130,mouse.y-130,260,260);
    }

    // Gentle horizontal digital wave lines.
    for(let j=0;j<5;j++){
      wctx.beginPath();
      for(let x=0;x<=width;x+=5){
        const y=height*.18+j*height*.16+
          Math.sin(x*.018+now*2+j)*8+
          Math.sin(x*.008-now*1.3+j)*5;
        if(x===0) wctx.moveTo(x,y);
        else wctx.lineTo(x,y);
      }
      wctx.strokeStyle='rgba(30,255,120,.10)';
      wctx.lineWidth=1;
      wctx.stroke();
    }

    ripples=ripples.filter(r=>r.life>0);
    ripples.forEach(r=>{
      r.radius+=3;
      r.life-=.025;
      wctx.beginPath();
      wctx.arc(r.x,r.y,r.radius,0,Math.PI*2);
      wctx.strokeStyle='rgba(57,255,136,'+r.life+')';
      wctx.stroke();
    });
  }

  function animate(){
    drawRain();
    drawWaves();
    requestAnimationFrame(animate);
  }

  resize();
  window.addEventListener('resize',resize);
  animate();
})();
</script>
